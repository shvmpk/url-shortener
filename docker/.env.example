# =============================================================================
# URL Shortener — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Kafka ---
KAFKA_PORT=9092

# --- Redis ---
REDIS_PORT=6379

# --- PostgreSQL ---
POSTGRES_PORT=5432
POSTGRES_DB=url_shortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# --- Jaeger ---
JAEGER_UI_PORT=16686

# --- Loki ---
LOKI_PORT=3100

# --- CORS (set to specific origin in production, e.g. https://myapp.com) ---
CORS_ALLOWED_ORIGINS=*

# --- Application Resource Limits ---
SHORTENER_MEM_LIMIT=512m
SHORTENER_CPU=0.5
REDIRECT_MEM_LIMIT=512m
REDIRECT_CPU=0.5
ANALYTICS_MEM_LIMIT=512m
ANALYTICS_CPU=0.5
GATEWAY_MEM_LIMIT=512m
GATEWAY_CPU=0.5
